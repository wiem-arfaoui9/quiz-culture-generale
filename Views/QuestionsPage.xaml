<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.Views.QuestionsPage"
             x:Name="page"
             Title="Questions">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">
        <Button Grid.Row="0" Text="➕ Ajouter une question" Command="{Binding AddCommand}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Questions}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="12" CornerRadius="10">
                        <VerticalStackLayout Spacing="6">
                            <Label FontSize="18" FontAttributes="Bold" Text="{Binding Text}" />
                            <Label TextColor="Gray" Text="{Binding LevelText}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="✏ Modifier"
                                        Command="{Binding BindingContext.EditCommand, Source={x:Reference page}}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="🗑 Supprimer" BackgroundColor="Red"
                                        Command="{Binding BindingContext.DeleteCommand, Source={x:Reference page}}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>