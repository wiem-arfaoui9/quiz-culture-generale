<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.Views.LoginPage" Title="Connexion">
    <VerticalStackLayout Padding="30" Spacing="14" VerticalOptions="Center">
        <Label Text="🎓 QuizMaster" FontSize="32" HorizontalOptions="Center" />
        <Entry Placeholder="Nom d'utilisateur" Text="{Binding Username}" />
        <Entry Placeholder="Mot de passe" IsPassword="True" Text="{Binding Password}" />
        <Label Text="{Binding Error}" TextColor="Red" />
        <Button Text="Se connecter" Command="{Binding LoginCommand}" />
        <Button Text="Créer un compte" Command="{Binding GoRegisterCommand}" />
    </VerticalStackLayout>
</ContentPage>