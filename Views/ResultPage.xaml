<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.Views.ResultPage"
             Title="Résultat"
             Background="{StaticResource HeroGradient}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="24" VerticalOptions="Center">
            <Border Style="{StaticResource Card}" Padding="26,30" StrokeShape="RoundRectangle 28">
                <VerticalStackLayout Spacing="14">

                    <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="0" Margin="0,6">
                        <Label Text="{Binding Score}" FontFamily="OpenSansSemibold" FontSize="64"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandTextDark}}" />
                        <Label Text="⭐ points" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Chip}" HorizontalOptions="Center" Padding="14,6">
                        <Label Text="{Binding Level, StringFormat='Niveau atteint : {0}'}" Style="{StaticResource ChipLabel}" />
                    </Border>

                    <Label Text="{Binding Best}" Style="{StaticResource MutedLabel}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                    <Button Text="🔁  Rejouer" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReplayCommand}" Margin="0,10,0,0" />
                    <Button Text="🏠  Accueil" Style="{StaticResource SecondaryButton}"
                            Command="{Binding HomeCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>