<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.Views.RegisterPage" Title="Inscription">
    <VerticalStackLayout Padding="30" Spacing="14" VerticalOptions="Center">
        <Label Text="Créer un compte" FontSize="28" HorizontalOptions="Center" />
        <Entry Placeholder="Nom d'utilisateur" Text="{Binding Username}" />
        <Entry Placeholder="Mot de passe (6 caractères min.)" IsPassword="True" Text="{Binding Password}" />
        <Label Text="{Binding Error}" TextColor="Red" />
        <Button Text="S'inscrire" Command="{Binding RegisterCommand}" />
        <Button Text="Retour" Command="{Binding BackCommand}" />
    </VerticalStackLayout>
</ContentPage>